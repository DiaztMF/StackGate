# Port server live (Render menggunakan port 3000 sesuai Dockerfile.live)
PORT=3000

# Versi aplikasi
APP_VERSION=1.4.2

# URL Backend Hono StackGate di Vercel
API_BASE_URL=https://stackgate-api.vercel.app

# URL Frontend Web StackGate di Vercel (untuk CORS WebSocket)
CORS_ALLOWED_ORIGINS=https://stackgate-web.vercel.app

# Path WebSocket Hocuspocus/Yjs
LIVE_BASE_PATH=/live

# Kunci rahasia internal komunikasi server
LIVE_SERVER_SECRET_KEY=stackgate-live-secret-key-2026

# URL Redis Upstash (ganti dengan kredensial Upstash Anda dari console.upstash.com)
REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_UPSTASH_HOST.upstash.io:6379

# Opsi kompresi WebSocket
COMPRESSION_LEVEL=6
COMPRESSION_THRESHOLD=5000
